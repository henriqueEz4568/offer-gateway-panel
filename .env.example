# URL base da API NestJS do Offer Gateway (obrigatória fora do modo release).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Cores do tema usadas quando GET {API}/theme não responde (opcionais, #RRGGBB).
# Prioridade: API > estas variáveis > padrão preto e branco.
# NEXT_PUBLIC_THEME_PRIMARY=#2563eb
# NEXT_PUBLIC_THEME_SECONDARY=#f59e0b

# Modo release: troca todas as chamadas da API por dados fictícios em memória.
# Só liga com o valor exato "release". NUNCA defina isto em produção.
# NEXT_PUBLIC_NODE_ENV=release
